# =========================================================================
# AI Audio Hub - Environment Configuration
# Copy this file to .env and modify paths according to your environment.
# =========================================================================

# --- WebUI Server Settings ---
WEBUI_HOST="0.0.0.0"
# Must match webui/app.py's default and the README; this said 8012 while both
# of those said 8013, so copying this file moved the UI without saying so.
WEBUI_PORT=8013

# --- API Endpoints (For the WebUI to route requests) ---
WHISPERX_API_URL="http://127.0.0.1:8088"
# FASTER_WHISPER_API_URL is gone: nothing ever read it, and it pointed at 8013
# -- the WebUI's own port -- so anything that had started using it would have
# been calling this service. start-all.sh launches that service via
# FASTER_WHISPER_SERVICE_SCRIPT below, which is the setting that is real.
GEMMA_LLM_API_URL="http://127.0.0.1:18082"
# Optional bearer token for the LLM endpoint. Local llama.cpp and vLLM usually
# need none; the AI secretary panel can also supply one per browser.
LLM_API_KEY=""

# --- Local Service Paths (For start-all.sh to launch services) ---
# If these paths are set and valid, start-all.sh will try to launch them.
# Leave them empty if you manage these services separately (e.g. via systemd).

# 1. WhisperX Service
WHISPERX_SERVICE_SCRIPT="/media/nvidia/sd/whisperx-service/service.py"
WHISPERX_VENV="/media/nvidia/sd/qwen3/jp511-venv"

# 2. Faster Whisper Service
FASTER_WHISPER_SERVICE_SCRIPT="/home/nvidia/faster_whisper_server.py"
FASTER_WHISPER_VENV="/home/nvidia/venv-fw-asr"

# 3. Gemma-4-E2B (llama.cpp) Service
# Example: "/home/nvidia/src/llama.cpp/build/bin/llama-server -m models/gemma.gguf --port 18082"
LLAMA_SERVER_CMD="" 
